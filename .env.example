# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# DO NOT commit .env to source control
# ─────────────────────────────────────────────────────────────────────────────

# ── Port / Server ────────────────────────────────────────────────────────────
PORT=10000

# ── Twilio Voice / WhatsApp Helpline ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Qdrant Cloud (Managed Vector Database) ───────────────────────────────────
QDRANT_CLOUD_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION=schemes_hybrid

# ── AWS Credentials (Bedrock Nova & AWS Transcribe) ──────────────────────────
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
BEDROCK_LLM_MODEL=eu.amazon.nova-lite-v1:0
TRANSCRIBE_S3_BUCKET=government-scheme
